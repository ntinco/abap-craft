#!/bin/sh
# Versioned hook; enable once per clone: git config core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! out=$(python3 tools/health_check.py --strict 2>&1); then
    printf '%s\n' "$out" >&2
    echo "pre-commit: health check failed; commit aborted" >&2
    exit 1
fi
